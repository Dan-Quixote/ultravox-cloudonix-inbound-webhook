name = "cloudonix-inbound-worker"
main = "src/index.ts"
compatibility_date = "2025-02-14"

[vars]
ULTRAVOX_AGENT_ID = "your-ultravox-agent-id"
ULTRAVOX_SIP_DOMAIN = "your-ultravox-sip-domain.voximplant.com"

# Secrets (set via `wrangler secret put`):
#   WEBHOOK_SECRET       - Matches X-CX-APIKey header from Cloudonix
#   LOOKUP_URL           - URL to fetch caller context (optional)
